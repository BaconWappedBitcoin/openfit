<?xml version="1.0" encoding="utf-8"?>
<!-- Android backup to the user's Google Drive and device-to-device transfer (user request
     2026-11-24: settings persist on a new device). Everything the runner set up comes along:
     profiles, settings, workouts, history, coach look. Left out: saved keys (sealed by this
     tablet's Keystore, unreadable elsewhere; re-enter them after a restore), the treadmill link
     and "workout running" flag (this tablet only), and caches that are fetched again. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="ofit_secrets.xml" />
        <exclude domain="sharedpref" path="ofit_device.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
        <exclude domain="sharedpref" path="AwOriginVisitLoggerPrefs.xml" />
        <exclude domain="file" path="profileInstalled" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="ofit_secrets.xml" />
        <exclude domain="sharedpref" path="ofit_device.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
        <exclude domain="sharedpref" path="AwOriginVisitLoggerPrefs.xml" />
        <exclude domain="file" path="profileInstalled" />
    </device-transfer>
</data-extraction-rules>
