<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!--
      The scan is never used to work out where the user is, so it says so. Without this flag,
      Android 12 and above hand scan results to the app only when it also holds the location
      permission, and this app deliberately never asks for location: every result was silently
      dropped and the treadmill never appeared.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!--
      The location permission is only needed for Bluetooth scanning on Android 11 and below. On
      Android 12 and above the Bluetooth permissions are enough, and asking for location there
      would be a permission the user has no reason to grant. Android 12 also requires the coarse
      permission to be declared alongside the fine one.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The internet is only needed for video search, YouTube playback and the community library.
      Everything that drives the treadmill, and every imported program afterwards, works with no
      network at all.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TreadmillApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ofit">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.ofit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TreadmillService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
